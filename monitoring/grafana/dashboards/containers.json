{
  "uid": "containers",
  "title": "Containers",
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU by project",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_project) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))",
          "legendFormat": "{{container_label_com_docker_compose_project}}",
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory by project",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_project) (container_memory_working_set_bytes{name!=\"\"})",
          "legendFormat": "{{container_label_com_docker_compose_project}}",
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Top memory",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, container_memory_working_set_bytes{name!=\"\"})",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Restarts in 24 h",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, changes(container_start_time_seconds{name!=\"\"}[24h]) > 0)",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ]
    }
  ]
}
