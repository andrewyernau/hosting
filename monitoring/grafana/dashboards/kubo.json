{
  "uid": "kubo",
  "title": "Kubo",
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"gaming-api\"}",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Worker",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"gaming-worker\"}",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "PostgreSQL",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Jobs pending",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yernau_gaming_jobs_pending",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Requests by status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(yernau_gaming_http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Request duration p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(yernau_gaming_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Job outcomes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, outcome) (increase(yernau_gaming_job_outcomes_total[15m]))",
          "legendFormat": "{{kind}} {{outcome}}",
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "title": "Rate limited",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scope) (rate(yernau_gaming_rate_limited_total[5m]))",
          "legendFormat": "{{scope}}",
          "instant": false
        }
      ]
    }
  ]
}
