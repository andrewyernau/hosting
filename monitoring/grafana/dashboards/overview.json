{
  "uid": "overview",
  "title": "Overview",
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Services answering",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(probe_success)",
          "legendFormat": "up",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "count(probe_success)",
          "legendFormat": "total",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Firing alerts",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Oldest backup",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(time() - backup_last_success_timestamp_seconds)",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Soonest certificate expiry",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(probe_ssl_earliest_cert_expiry - time())",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Availability",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Response time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"web\"}",
          "legendFormat": "{{instance}}",
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Firing alerts",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{alertname}}",
          "instant": false
        }
      ]
    }
  ]
}
